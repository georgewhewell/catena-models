# Sequence releases after the buffer's last consuming kernel. The phase is a
# non-unit erased dependency, so product unpacking preserves the ordering edge.
(def program stdlib.models.resources.free-f32-before : {((cap.own mem) val) ((cap.own mem) val)} -> ((cap.own mem) val) =
 ([old after.]
  ([.after] meta.master.complete-own [result phase.])
  ({[.old] [.phase]} meta.master.after-own [ready.])
  ([.ready] stdlib.models.memory.free unit.elim)
  [.result]
 ))
(def program stdlib.models.resources.free-bf16-before : {((cap.own mem) val) ((cap.own mem) val)} -> ((cap.own mem) val) =
 ([old after.]
  ([.after] meta.master.complete-own [result phase.])
  ({[.old] [.phase]} meta.master.after-own [ready.])
  ([.ready] stdlib.models.memory.free-bf16 unit.elim)
  [.result]
 ))

# Keep session scratch alive while preserving the consuming buffer dependency.
(def program stdlib.models.resources.keep-bf16-before : {((cap.own mem) val) ((cap.own mem) val)} -> ((cap.own mem) val) =
 ([old after.] ([.after] meta.master.complete-own [result phase.])
  ({[.old] [.phase]} meta.master.after-own [ready.]) [.result]))
