# Materialize row-wise weight normalization. Each block reduces one F32 row.
# Output is BF16 after multiplication by the row gain divided by its L2 norm.
(def program stdlib.weights.row-norm.square : {((cap.ref mem) val) (u64 val) (u64 val) ({(u64 val) (f32 val)} *)} -> (f32 val) =
 ([input base tid pair.]
  ([.pair] *.elim [i acc.])
  ({[.i] (const.u64.0x0000000000000100)} stdlib.models.memory.u64.mul [stride.])
  ({[.stride] [.tid]} stdlib.models.memory.u64.add [channel.])
  ({[.base] [.channel]} stdlib.models.memory.u64.add [offset.])
  ({[.input] [.offset]} stdlib.models.memory.ref-read-f32 [f.])
  ({[.f] [.f]} stdlib.models.memory.f32.mul [squared.])
  ({[.acc] [.squared]} stdlib.models.memory.f32.add [sum.])
  [.sum]
 ))
