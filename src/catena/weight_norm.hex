  ([.less] unsafe.discard unit.elim)
  ([.index] :.forget [i.])
  ({[.i] [.value]} *.intro [arguments.])
  ({[.input] [.base] [.tid] [.arguments]} stdlib.weights.row-norm.square [result.])
  ({[.result] [.truth]} *.intro)
 ))
