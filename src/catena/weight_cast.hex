(def program {{FAMILY}}.element : {{{ARG}} ((cap.own mem) val) (u64 val)} -> 1 =
 ([input out element.]
{{INDEX}}
 ({[.memory] [.index]} stdlib.models.memory.ref-read-{{INPUT}} [value.])
 ({{VALUE}} [result.])
 ({[.out] [.element] [.result]} stdlib.models.memory.write-{{OUTPUT}})
 (unit.elim)
 (unit.intro)
 ))

(def program {{FAMILY}}.yes : {{{ARG}} ((cap.own mem) val) ({(u64 val) ({((master.predicate prop.IsTrue) |-) 1} *)} *)} -> 1 =
 ([input out pair.]
 ([.pair] *.elim [element proofs.])
 ([.proofs] *.elim [proof unit.])
 ([.proof] unsafe.discard unit.elim)
 ([.unit] unit.elim)
 ({[.input] [.out] [.element]} {{FAMILY}}.element)
 ))

(def program {{FAMILY}}.no : {{{ARG}} ((cap.own mem) val) ({(u64 val) ({(({(master.predicate prop.IsTrue)} stdlib.prelude.prop.Not) |-) 1} *)} *)} -> 1 =
 ([input out pair.]
 ([.pair] *.elim [element proofs.])
 ([.proofs] *.elim [proof unit.])
 ([.proof] unsafe.discard unit.elim)
